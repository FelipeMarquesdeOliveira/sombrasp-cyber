# Copie para ".env" e troque os valores. O arquivo .env NÃO vai para o Git.
MYSQL_ROOT_PASSWORD=troque-por-uma-senha-forte-do-root
DB_PASSWORD=troque-por-uma-senha-forte-da-aplicacao
JWT_SECRET=troque-por-um-segredo-longo-com-pelo-menos-32-caracteres

# Chave mestra (Base64, 32 bytes) usada para cifrar dados pessoais no banco.
# Gere com: openssl rand -base64 32
PII_CHAVE=troque-por-32-bytes-em-base64

# Chave da API da MiniMax (https://www.minimax.io). Sem chave, o app usa uma mensagem
# padrão e marca a origem como "PADRAO" no painel.
MINIMAX_API_KEY=
